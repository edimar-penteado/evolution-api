{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/simpliweb/.pm2/logs/evolution-api-out*.log",
            "log_group_name": "/simpliweb/production/evolution-api",
            "log_stream_name": "{hostname}/out",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/home/simpliweb/.pm2/logs/evolution-api-error*.log",
            "log_group_name": "/simpliweb/production/evolution-api",
            "log_stream_name": "{hostname}/error",
            "retention_in_days": 30,
            "timezone": "UTC"
          },
          {
            "file_path": "/home/simpliweb/.pm2/pm2.log",
            "log_group_name": "/simpliweb/production/evolution-api",
            "log_stream_name": "{hostname}/pm2",
            "retention_in_days": 30,
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}