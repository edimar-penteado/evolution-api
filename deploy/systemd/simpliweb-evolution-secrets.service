[Unit]
Description=Render Evolution API runtime environment from AWS
Wants=network-online.target
After=network-online.target
Before=pm2-simpliweb.service
ConditionPathExists=/srv/evolution-api/current/deploy/aws/render-runtime-env.cjs

[Service]
Type=oneshot
User=simpliweb
Group=simpliweb
WorkingDirectory=/srv/evolution-api/current
EnvironmentFile=/etc/simpliweb/simpliweb-evolution-secrets.conf
UMask=0077
RuntimeDirectory=simpliweb
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ExecStart=/bin/sh -c 'exec "$NODE_BIN" /srv/evolution-api/current/deploy/aws/render-runtime-env.cjs'
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
RequiredBy=pm2-simpliweb.service